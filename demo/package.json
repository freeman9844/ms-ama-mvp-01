{
  "name": "capstone-local-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests --no-error-on-unmatched-pattern",
    "format:check": "prettier --check src tests",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.28",
    "express": "4.22.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "@github/copilot-sdk": {
      "zod": "$zod"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "4.17.25",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1-alpha.7",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
